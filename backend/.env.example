# Jamendo Developer API Client ID
# Register for free at: https://devportal.jamendo.com
# 1. Create an account and log in
# 2. Create a new Application
# 3. Copy the client_id shown on the app's dashboard page
# 4. Paste it below (remove the placeholder text)
JAMENDO_CLIENT_ID=your_client_id_here

# Spotify API Credentials (for metadata search only — no audio streaming)
# Register for free at: https://developer.spotify.com/dashboard
# 1. Log in and click "Create app"
# 2. Set Redirect URI to http://localhost:5000 (required by form, not used at runtime)
# 3. Copy the Client ID and Client Secret from the app dashboard
# NEVER expose SPOTIFY_CLIENT_SECRET in frontend code or commit it to git.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
